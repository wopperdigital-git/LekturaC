# Copy this file to .env and fill in the keys you have. Vite reads .env at
# startup, so restart `npm run dev` after changing it.
#
# Every VITE_* value is baked into the client JS at build time: anyone who can
# load a built app can read them. Local/personal dev only — never deploy a
# build with the billed keys (Anthropic, Cartesia) somewhere others can reach.

# Supabase — the shared project. The anon/publishable key is safe to share
# (row-level security protects the data). Required: without these nobody can
# log in.
VITE_SUPABASE_URL=https://lgpsgimrdrfntgxjepbe.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_7e5wp12Sg3UU0MgDlNXdiA_BapN5Ut0

# AI providers. Deck generation tries them in this order and fails over on
# rate limits: Anthropic -> Groq -> Gemini (PROVIDER_CHAIN in
# src/ai/fallbackProvider.ts). Any may be left blank (it drops out of the
# chain), but at least one is required to create a deck.

# Claude — first in the chain when present. BILLED per token, including
# research's web search. console.anthropic.com
VITE_ANTHROPIC_API_KEY=

# Model override for the Anthropic link; defaults to claude-sonnet-5 if unset.
# VITE_ANTHROPIC_MODEL=

# Groq — free tier at console.groq.com/keys. Also the only provider for quiz
# generation; without it the editor's Quiz button is disabled.
VITE_GROQ_API_KEY=

# Gemini — free tier at aistudio.google.com/apikey. Last in the chain.
VITE_GEMINI_API_KEY=

# Cartesia (voice cloning, preview and narrated video). play.cartesia.ai/keys.
# BILLED, and a FULL-ACCOUNT key: anyone with a built app can spend on it and
# list or delete your voices. Without it the Clone voice button is disabled.
VITE_CARTESIA_API_KEY=
